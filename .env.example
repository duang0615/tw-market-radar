# ── AI 摘要（選用）─────────────────────────────────────
# 三個都有值才會啟用 LLM；沒設就自動改用「資料統計 fallback」，網站照常運作。
# 任何 OpenAI 相容的服務都可以，模型不寫死。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# ── 資料來源開關 ───────────────────────────────────────
GOOGLE_NEWS_ENABLED=true     # 產業關鍵字搜尋，主要的事件來源
TWSE_QUOTES_ENABLED=true     # 全市場行情，用來算「市場異動」
PTT_ENABLED=true             # PTT Stock / Tech_Job 公開 Atom

GDELT_ENABLED=false          # 免費但很常回 429，預設關
REDDIT_ENABLED=false         # 公開 .json 端點已被擋（403），要自己申請 OAuth app
YOUTUBE_ENABLED=false        # 要自己填頻道 ID
YOUTUBE_CHANNEL_IDS=

# 注意：.env 不要 commit。API key 只放 GitHub Secrets。
